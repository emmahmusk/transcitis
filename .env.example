DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
TIME_ZONE=Africa/Lagos

# Local development uses SQLite when DEBUG=True. Production requires a valid PostgreSQL URL when DEBUG=False.
# Supabase transaction-pooler URLs (port 6543) are supported; replace the password placeholder before use.
DATABASE_URL=postgresql://postgres.fucchzewmgbbrsttarte:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# Google SMTP: use a Google App Password where 2-Step Verification is enabled.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Transcitis Operations <no-reply@transcitis.com>
SITE_URL=http://127.0.0.1:8000

# Optional: Gemini API key for sourced Google Search product-value suggestions.
# Google Custom Search JSON API is closed to new customers; this uses Gemini Search grounding instead.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_SEARCH_MODEL=gemini-3.8-flash

AYOTOY_APP_PASSWORD=
AYOTOY_Google_App_Name=webapp
